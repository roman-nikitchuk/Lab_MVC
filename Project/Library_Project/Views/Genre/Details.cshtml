@model Library_Project.Models.Genre

@{
    ViewData["Title"] = "Genre Details";
}

<style>
    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: #6b7280;
        font-size: 14px;
        text-decoration: none;
        margin-bottom: 20px;
        transition: color 0.15s;
    }

        .back-link:hover {
            color: #111827;
            text-decoration: none;
        }

        .back-link svg {
            width: 16px;
            height: 16px;
        }

    .detail-card {
        background: #fff;
        border-radius: 12px;
        border: 1px solid #e5e7eb;
        padding: 28px;
        margin-bottom: 24px;
    }

    .genre-header {
        display: flex;
        align-items: center;
        gap: 16px;
        margin-bottom: 24px;
        padding-bottom: 24px;
        border-bottom: 1px solid #f3f4f6;
    }

    .genre-icon {
        width: 64px;
        height: 64px;
        border-radius: 12px;
        background: #f0fdf4;
        color: #15803d;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .genre-icon svg {
            width: 28px;
            height: 28px;
            stroke: #15803d;
        }

    .genre-header h2 {
        font-size: 22px;
        font-weight: 600;
        color: #111827;
        margin: 0 0 4px;
    }

    .genre-header p {
        font-size: 14px;
        color: #6b7280;
        margin: 0;
    }

    .books-card {
        background: #fff;
        border-radius: 12px;
        border: 1px solid #e5e7eb;
        overflow: hidden;
    }

    .books-card-header {
        padding: 16px 20px;
        border-bottom: 1px solid #e5e7eb;
        font-size: 15px;
        font-weight: 600;
        color: #111827;
    }

    .book-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 20px;
        border-bottom: 1px solid #f3f4f6;
        font-size: 14px;
        color: #374151;
    }

        .book-item:last-child {
            border-bottom: none;
        }

        .book-item svg {
            width: 16px;
            height: 16px;
            stroke: #0d9488;
            flex-shrink: 0;
        }

    .action-row {
        display: flex;
        gap: 12px;
        margin-top: 24px;
    }

    .btn-edit-lg {
        background: #0d9488;
        color: #fff;
        border-radius: 8px;
        padding: 10px 20px;
        font-size: 14px;
        font-weight: 500;
        text-decoration: none;
        transition: background 0.15s;
    }

        .btn-edit-lg:hover {
            background: #0f766e;
            color: #fff;
            text-decoration: none;
        }

    .btn-back-lg {
        background: #f3f4f6;
        color: #374151;
        border-radius: 8px;
        padding: 10px 20px;
        font-size: 14px;
        font-weight: 500;
        text-decoration: none;
        transition: background 0.15s;
    }

        .btn-back-lg:hover {
            background: #e5e7eb;
            color: #374151;
            text-decoration: none;
        }
</style>

<a asp-action="Index" class="back-link">
    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
    </svg>
    Back to Genres
</a>

<div class="detail-card">
    <div class="genre-header">
        <div class="genre-icon">
            <svg fill="none" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A2 2 0 013 8V5a2 2 0 012-2z" />
            </svg>
        </div>
        <div>
            <h2>@Model.Name</h2>
            <p>@(Model.Books?.Count ?? 0) books in this genre</p>
        </div>
    </div>
</div>

@if (Model.Books != null && Model.Books.Any())
{
    <div class="books-card">
        <div class="books-card-header">Books in @Model.Name</div>
        @foreach (var book in Model.Books)
        {
            <div class="book-item">
                <svg fill="none" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                </svg>
                @book.Name
            </div>
        }
    </div>
}

<div class="action-row">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-edit-lg">Edit</a>
    <a asp-action="Index" class="btn-back-lg">Back</a>
</div>