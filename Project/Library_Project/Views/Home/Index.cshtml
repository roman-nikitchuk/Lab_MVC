@{
    ViewData["Title"] = "Home";
}

<style>
    .hero {
        background: linear-gradient(135deg, #1e3a5f 0%, #2d5282 100%);
        border-radius: 14px;
        padding: 40px 36px;
        margin-bottom: 24px;
    }

        .hero h1 {
            font-size: 32px;
            color: #fff;
            font-weight: 700;
            margin-bottom: 8px;
        }

        .hero p {
            color: rgba(255,255,255,0.7);
            font-size: 15px;
            margin-bottom: 24px;
        }

    .search-bar {
        display: flex;
        align-items: center;
        gap: 10px;
        background: rgba(255,255,255,0.12);
        border: 1px solid rgba(255,255,255,0.2);
        border-radius: 8px;
        padding: 10px 16px;
        max-width: 480px;
    }

        .search-bar input {
            background: none;
            border: none;
            outline: none;
            color: #fff;
            font-size: 14px;
            width: 100%;
        }

            .search-bar input::placeholder {
                color: rgba(255,255,255,0.45);
            }

    .search-icon {
        color: rgba(255,255,255,0.5);
        font-size: 16px;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
        margin-bottom: 24px;
    }

    .stat-card {
        background: #fff;
        border-radius: 12px;
        padding: 20px;
        border: 1px solid #e5e7eb;
    }

    .stat-icon {
        width: 44px;
        height: 44px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 14px;
    }

        .stat-icon.teal {
            background: #0d9488;
        }

        .stat-icon.navy {
            background: #1e3a5f;
        }

        .stat-icon svg {
            width: 22px;
            height: 22px;
            stroke: #fff;
            fill: none;
        }

    .stat-number {
        font-size: 28px;
        font-weight: 600;
        color: #111827;
        line-height: 1;
        margin-bottom: 4px;
    }

    .stat-label {
        font-size: 13px;
        color: #6b7280;
    }

    .quick-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
    }

    .quick-card {
        background: #fff;
        border-radius: 12px;
        padding: 24px;
        border: 1px solid #e5e7eb;
        text-decoration: none;
        display: block;
        transition: all 0.15s;
    }

        .quick-card:hover {
            border-color: #0d9488;
            box-shadow: 0 4px 12px rgba(13,148,136,0.1);
            text-decoration: none;
        }

        .quick-card svg {
            width: 32px;
            height: 32px;
            stroke: #0d9488;
            fill: none;
            margin-bottom: 12px;
        }

        .quick-card h3 {
            font-size: 15px;
            font-weight: 600;
            color: #111827;
            margin-bottom: 6px;
        }

        .quick-card p {
            font-size: 13px;
            color: #6b7280;
            line-height: 1.5;
        }
</style>

<div class="hero">
    <h1>Welcome to LibraryHub</h1>
    <p>Your comprehensive library management solution</p>
    <form asp-controller="Book" asp-action="Index" method="get" style="max-width: 480px;">
        <div class="search-bar">
            <span class="search-icon">
                <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0" />
                </svg>
            </span>
            <input type="text" name="search" placeholder="Search for books, authors, or genres..." />
        </div>
    </form>
</div>

<div class="stats-grid">
    <div class="stat-card">
        <div class="stat-icon teal">
            <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" /></svg>
        </div>
        <div class="stat-number">@ViewBag.TotalBooks</div>
        <div class="stat-label">Total Books</div>
    </div>
    <div class="stat-card">
        <div class="stat-icon navy">
            <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
        </div>
        <div class="stat-number">@ViewBag.TotalAuthors</div>
        <div class="stat-label">Authors</div>
    </div>
    <div class="stat-card">
        <div class="stat-icon teal">
            <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A2 2 0 013 8V5a2 2 0 012-2z" /></svg>
        </div>
        <div class="stat-number">@ViewBag.TotalGenres</div>
        <div class="stat-label">Genres</div>
    </div>
    <div class="stat-card">
        <div class="stat-icon navy">
            <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
        </div>
        <div class="stat-number">@ViewBag.TotalUsers</div>
        <div class="stat-label">Active Members</div>
    </div>
</div>

<div class="quick-grid">
    <a asp-controller="Book" asp-action="Index" class="quick-card">
        <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" /></svg>
        <h3>Browse Books</h3>
        <p>Explore our collection of books</p>
    </a>
    <a asp-controller="Author" asp-action="Index" class="quick-card">
        <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
        <h3>View Authors</h3>
        <p>Discover authors in our library</p>
    </a>
    <a asp-controller="Borrowing" asp-action="Index" class="quick-card">
        <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" /></svg>
        <h3>Manage Borrowings</h3>
        <p>Track borrowed books and returns</p>
    </a>
</div>