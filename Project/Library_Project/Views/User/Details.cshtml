@model Library_Project.Models.User

@{
    ViewData["Title"] = "User Details";
}

<style>
    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: #6b7280;
        font-size: 14px;
        text-decoration: none;
        margin-bottom: 20px;
        transition: color 0.15s;
    }

        .back-link:hover {
            color: #111827;
            text-decoration: none;
        }

        .back-link svg {
            width: 16px;
            height: 16px;
        }

    .detail-card {
        background: #fff;
        border-radius: 12px;
        border: 1px solid #e5e7eb;
        padding: 28px;
        margin-bottom: 24px;
    }

    .user-header {
        display: flex;
        align-items: center;
        gap: 16px;
        margin-bottom: 24px;
        padding-bottom: 24px;
        border-bottom: 1px solid #f3f4f6;
    }

    .user-avatar-lg {
        width: 64px;
        height: 64px;
        border-radius: 50%;
        background: #e1f5ee;
        color: #0d9488;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        font-weight: 600;
    }

    .user-header h2 {
        font-size: 22px;
        font-weight: 600;
        color: #111827;
        margin: 0 0 4px;
    }

    .user-header p {
        font-size: 14px;
        color: #6b7280;
        margin: 0;
    }

    .detail-row {
        display: flex;
        gap: 8px;
        padding: 12px 0;
        border-bottom: 1px solid #f3f4f6;
        font-size: 14px;
    }

        .detail-row:last-child {
            border-bottom: none;
        }

    .detail-label {
        color: #6b7280;
        width: 140px;
        flex-shrink: 0;
    }

    .detail-value {
        color: #111827;
        font-weight: 500;
    }

    .borrowings-card {
        background: #fff;
        border-radius: 12px;
        border: 1px solid #e5e7eb;
        overflow: hidden;
    }

    .borrowings-card-header {
        padding: 16px 20px;
        border-bottom: 1px solid #e5e7eb;
        font-size: 15px;
        font-weight: 600;
        color: #111827;
    }

    .borrowing-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px 20px;
        border-bottom: 1px solid #f3f4f6;
        font-size: 14px;
    }

        .borrowing-item:last-child {
            border-bottom: none;
        }

    .borrowing-book {
        color: #111827;
        font-weight: 500;
    }

    .badge-status {
        border-radius: 6px;
        padding: 4px 10px;
        font-size: 12px;
        font-weight: 500;
    }

    .badge-active {
        background: #f0fdf4;
        color: #15803d;
    }

    .badge-returned {
        background: #f3f4f6;
        color: #6b7280;
    }

    .badge-overdue {
        background: #fef2f2;
        color: #dc2626;
    }

    .action-row {
        display: flex;
        gap: 12px;
        margin-top: 24px;
    }

    .btn-edit-lg {
        background: #0d9488;
        color: #fff;
        border-radius: 8px;
        padding: 10px 20px;
        font-size: 14px;
        font-weight: 500;
        text-decoration: none;
        transition: background 0.15s;
    }

        .btn-edit-lg:hover {
            background: #0f766e;
            color: #fff;
            text-decoration: none;
        }

    .btn-back-lg {
        background: #f3f4f6;
        color: #374151;
        border-radius: 8px;
        padding: 10px 20px;
        font-size: 14px;
        font-weight: 500;
        text-decoration: none;
        transition: background 0.15s;
    }

        .btn-back-lg:hover {
            background: #e5e7eb;
            color: #374151;
            text-decoration: none;
        }
</style>

<a asp-action="Index" class="back-link">
    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
    </svg>
    Back to Users
</a>

<div class="detail-card">
    <div class="user-header">
        <div class="user-avatar-lg">@Model.Name.Substring(0, 1).ToUpper()</div>
        <div>
            <h2>@Model.Name</h2>
            <p>@Model.Email</p>
        </div>
    </div>
    <div class="detail-row">
        <span class="detail-label">Full Name</span>
        <span class="detail-value">@Model.Name</span>
    </div>
    <div class="detail-row">
        <span class="detail-label">Email</span>
        <span class="detail-value">@Model.Email</span>
    </div>
    <div class="detail-row">
        <span class="detail-label">Registered</span>
        <span class="detail-value">@Model.CreatedAt.ToString("dd MMM yyyy")</span>
    </div>
</div>

@if (Model.Borrowings != null && Model.Borrowings.Any())
{
    <div class="borrowings-card">
        <div class="borrowings-card-header">Borrowing History</div>
        @foreach (var borrowing in Model.Borrowings)
        {
            <div class="borrowing-item">
                <span class="borrowing-book">@borrowing.Book?.Name</span>
                <span class="badge-status badge-@borrowing.Status.ToString().ToLower()">@borrowing.Status</span>
            </div>
        }
    </div>
}

<div class="action-row">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-edit-lg">Edit</a>
    <a asp-action="Index" class="btn-back-lg">Back</a>
</div>