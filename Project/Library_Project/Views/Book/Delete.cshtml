@model Library_Project.Models.Book

@{
    ViewData["Title"] = "Delete Book";
}

<style>
    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: #6b7280;
        font-size: 14px;
        text-decoration: none;
        margin-bottom: 20px;
        transition: color 0.15s;
    }

        .back-link:hover {
            color: #111827;
            text-decoration: none;
        }

        .back-link svg {
            width: 16px;
            height: 16px;
        }

    @if (TempData["Error"] != null)
    {
        <div style="background: #fef2f2; border: 1px solid #fecaca; border-radius: 8px; padding: 12px 16px; margin-bottom: 16px; font-size: 14px; color: #dc2626;">
            @TempData["Error"]
        </div>
    }

    .delete-card {
        background: #fff;
        border-radius: 12px;
        border: 1px solid #e5e7eb;
        padding: 28px;
        max-width: 480px;
    }

    .delete-icon {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        background: #fef2f2;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 16px;
    }

        .delete-icon svg {
            width: 24px;
            height: 24px;
            stroke: #dc2626;
        }

    .delete-card h2 {
        font-size: 18px;
        font-weight: 600;
        color: #111827;
        margin-bottom: 8px;
    }

    .delete-card p {
        font-size: 14px;
        color: #6b7280;
        margin-bottom: 24px;
        line-height: 1.6;
    }

        .delete-card p strong {
            color: #111827;
        }

    .delete-info {
        background: #f9fafb;
        border-radius: 8px;
        padding: 16px;
        margin-bottom: 24px;
    }

    .delete-info-row {
        display: flex;
        gap: 8px;
        font-size: 14px;
        padding: 4px 0;
    }

    .delete-info-label {
        color: #6b7280;
        width: 100px;
    }

    .delete-info-value {
        color: #111827;
        font-weight: 500;
    }

    .form-actions {
        display: flex;
        gap: 12px;
    }

    .btn-delete {
        background: #dc2626;
        color: #fff;
        border: none;
        border-radius: 8px;
        padding: 10px 24px;
        font-size: 14px;
        font-weight: 500;
        cursor: pointer;
        transition: background 0.15s;
    }

        .btn-delete:hover {
            background: #b91c1c;
        }

    .btn-cancel {
        background: #f3f4f6;
        color: #374151;
        border-radius: 8px;
        padding: 10px 24px;
        font-size: 14px;
        font-weight: 500;
        text-decoration: none;
        transition: background 0.15s;
    }

        .btn-cancel:hover {
            background: #e5e7eb;
            color: #374151;
            text-decoration: none;
        }
</style>

<a asp-action="Index" class="back-link">
    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
    </svg>
    Back to Books
</a>

<div class="delete-card">
    <div class="delete-icon">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
        </svg>
    </div>
    <h2>Delete Book</h2>
    <p>Are you sure you want to delete <strong>@Model.Name</strong>? This action cannot be undone.</p>
    <div class="delete-info">
        <div class="delete-info-row">
            <span class="delete-info-label">Title</span>
            <span class="delete-info-value">@Model.Name</span>
        </div>
        <div class="delete-info-row">
            <span class="delete-info-label">Author</span>
            <span class="delete-info-value">@Model.Author?.Name</span>
        </div>
        <div class="delete-info-row">
            <span class="delete-info-label">Genre</span>
            <span class="delete-info-value">@Model.Genre?.Name</span>
        </div>
        <div class="delete-info-row">
            <span class="delete-info-label">Year</span>
            <span class="delete-info-value">@Model.PublishYear</span>
        </div>
    </div>
    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <div class="form-actions">
            <button type="submit" class="btn-delete">Yes, Delete</button>
            <a asp-action="Index" class="btn-cancel">Cancel</a>
        </div>
    </form>
</div>