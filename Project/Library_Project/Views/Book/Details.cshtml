@model Library_Project.Models.Book

@{
    ViewData["Title"] = "Book Details";
}

<style>
    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: #6b7280;
        font-size: 14px;
        text-decoration: none;
        margin-bottom: 20px;
        transition: color 0.15s;
    }

        .back-link:hover {
            color: #111827;
            text-decoration: none;
        }

        .back-link svg {
            width: 16px;
            height: 16px;
        }

    .detail-card {
        background: #fff;
        border-radius: 12px;
        border: 1px solid #e5e7eb;
        padding: 28px;
        margin-bottom: 24px;
    }

    .book-header {
        display: flex;
        align-items: center;
        gap: 16px;
        margin-bottom: 24px;
        padding-bottom: 24px;
        border-bottom: 1px solid #f3f4f6;
    }

    .book-icon {
        width: 64px;
        height: 64px;
        border-radius: 12px;
        background: #e1f5ee;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .book-icon svg {
            width: 28px;
            height: 28px;
            stroke: #0d9488;
        }

    .book-header h2 {
        font-size: 22px;
        font-weight: 600;
        color: #111827;
        margin: 0 0 4px;
    }

    .book-header p {
        font-size: 14px;
        color: #6b7280;
        margin: 0;
    }

    .detail-row {
        display: flex;
        gap: 8px;
        padding: 12px 0;
        border-bottom: 1px solid #f3f4f6;
        font-size: 14px;
    }

        .detail-row:last-child {
            border-bottom: none;
        }

    .detail-label {
        color: #6b7280;
        width: 140px;
        flex-shrink: 0;
    }

    .detail-value {
        color: #111827;
        font-weight: 500;
    }

    .badge {
        border-radius: 6px;
        padding: 4px 10px;
        font-size: 12px;
        font-weight: 500;
    }

    .badge-genre {
        background: #f0fdf4;
        color: #15803d;
    }

    .badge-year {
        background: #f0f9ff;
        color: #0369a1;
    }

    .badge-copies {
        background: #fefce8;
        color: #854d0e;
    }

    .description-text {
        color: #374151;
        line-height: 1.6;
    }

    .action-row {
        display: flex;
        gap: 12px;
        margin-top: 24px;
    }

    .btn-edit-lg {
        background: #0d9488;
        color: #fff;
        border-radius: 8px;
        padding: 10px 20px;
        font-size: 14px;
        font-weight: 500;
        text-decoration: none;
        transition: background 0.15s;
    }

        .btn-edit-lg:hover {
            background: #0f766e;
            color: #fff;
            text-decoration: none;
        }

    .btn-back-lg {
        background: #f3f4f6;
        color: #374151;
        border-radius: 8px;
        padding: 10px 20px;
        font-size: 14px;
        font-weight: 500;
        text-decoration: none;
        transition: background 0.15s;
    }

        .btn-back-lg:hover {
            background: #e5e7eb;
            color: #374151;
            text-decoration: none;
        }
</style>

<a asp-action="Index" class="back-link">
    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
    </svg>
    Back to Books
</a>

<div class="detail-card">
    <div class="book-header">
        <div class="book-icon">
            <svg fill="none" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
            </svg>
        </div>
        <div>
            <h2>@Model.Name</h2>
            <p>by @Model.Author?.Name</p>
        </div>
    </div>
    <div class="detail-row">
        <span class="detail-label">Title</span>
        <span class="detail-value">@Model.Name</span>
    </div>
    <div class="detail-row">
        <span class="detail-label">Author</span>
        <span class="detail-value">@Model.Author?.Name</span>
    </div>
    <div class="detail-row">
        <span class="detail-label">Genre</span>
        <span class="detail-value"><span class="badge badge-genre">@Model.Genre?.Name</span></span>
    </div>
    <div class="detail-row">
        <span class="detail-label">Publish Year</span>
        <span class="detail-value"><span class="badge badge-year">@Model.PublishYear</span></span>
    </div>
    <div class="detail-row">
        <span class="detail-label">Copies</span>
        <span class="detail-value"><span class="badge badge-copies">@Model.CopiesCount</span></span>
    </div>
    @if (!string.IsNullOrEmpty(Model.Description))
    {
        <div class="detail-row">
            <span class="detail-label">Description</span>
            <span class="detail-value description-text">@Model.Description</span>
        </div>
    }
</div>

<div class="action-row">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-edit-lg">Edit</a>
    <a asp-action="Index" class="btn-back-lg">Back</a>
</div>