@model Library_Project.Models.Borrowing

@{
    ViewData["Title"] = "Borrowing Details";
}

<style>
    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: #6b7280;
        font-size: 14px;
        text-decoration: none;
        margin-bottom: 20px;
        transition: color 0.15s;
    }

        .back-link:hover {
            color: #111827;
            text-decoration: none;
        }

        .back-link svg {
            width: 16px;
            height: 16px;
        }

    .detail-card {
        background: #fff;
        border-radius: 12px;
        border: 1px solid #e5e7eb;
        padding: 28px;
        margin-bottom: 24px;
    }

    .borrowing-header {
        display: flex;
        align-items: center;
        gap: 16px;
        margin-bottom: 24px;
        padding-bottom: 24px;
        border-bottom: 1px solid #f3f4f6;
    }

    .borrowing-icon {
        width: 64px;
        height: 64px;
        border-radius: 12px;
        background: #e1f5ee;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .borrowing-icon svg {
            width: 28px;
            height: 28px;
            stroke: #0d9488;
        }

    .borrowing-header h2 {
        font-size: 22px;
        font-weight: 600;
        color: #111827;
        margin: 0 0 4px;
    }

    .borrowing-header p {
        font-size: 14px;
        color: #6b7280;
        margin: 0;
    }

    .detail-row {
        display: flex;
        gap: 8px;
        padding: 12px 0;
        border-bottom: 1px solid #f3f4f6;
        font-size: 14px;
    }

        .detail-row:last-child {
            border-bottom: none;
        }

    .detail-label {
        color: #6b7280;
        width: 140px;
        flex-shrink: 0;
    }

    .detail-value {
        color: #111827;
        font-weight: 500;
    }

    .badge {
        border-radius: 6px;
        padding: 4px 10px;
        font-size: 12px;
        font-weight: 500;
    }

    .badge-active {
        background: #f0fdf4;
        color: #15803d;
    }

    .badge-returned {
        background: #f3f4f6;
        color: #6b7280;
    }

    .badge-overdue {
        background: #fef2f2;
        color: #dc2626;
    }

    .badge-date {
        background: #f0f9ff;
        color: #0369a1;
        border-radius: 6px;
        padding: 4px 10px;
        font-size: 12px;
        font-weight: 500;
    }

    .action-row {
        display: flex;
        gap: 12px;
        margin-top: 24px;
    }

    .btn-edit-lg {
        background: #0d9488;
        color: #fff;
        border-radius: 8px;
        padding: 10px 20px;
        font-size: 14px;
        font-weight: 500;
        text-decoration: none;
        transition: background 0.15s;
    }

        .btn-edit-lg:hover {
            background: #0f766e;
            color: #fff;
            text-decoration: none;
        }

    .btn-back-lg {
        background: #f3f4f6;
        color: #374151;
        border-radius: 8px;
        padding: 10px 20px;
        font-size: 14px;
        font-weight: 500;
        text-decoration: none;
        transition: background 0.15s;
    }

        .btn-back-lg:hover {
            background: #e5e7eb;
            color: #374151;
            text-decoration: none;
        }
</style>

<a asp-action="Index" class="back-link">
    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
    </svg>
    Back to Borrowings
</a>

<div class="detail-card">
    <div class="borrowing-header">
        <div class="borrowing-icon">
            <svg fill="none" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
            </svg>
        </div>
        <div>
            <h2>@Model.Book?.Name</h2>
            <p>Borrowed by @Model.User?.Name</p>
        </div>
    </div>
    <div class="detail-row">
        <span class="detail-label">Book</span>
        <span class="detail-value">@Model.Book?.Name</span>
    </div>
    <div class="detail-row">
        <span class="detail-label">User</span>
        <span class="detail-value">@Model.User?.Name</span>
    </div>
    <div class="detail-row">
        <span class="detail-label">Borrow Date</span>
        <span class="detail-value"><span class="badge-date">@Model.BorrowDate.ToString("dd MMM yyyy")</span></span>
    </div>
    <div class="detail-row">
        <span class="detail-label">Return Date</span>
        <span class="detail-value">
            @if (Model.ReturnDate.HasValue)
            {
                <span class="badge-date">@Model.ReturnDate.Value.ToString("dd MMM yyyy")</span>
            }
            else
            {
                <span style="color:#9ca3af;">Not returned yet</span>
            }
        </span>
    </div>
    <div class="detail-row">
        <span class="detail-label">Status</span>
        <span class="detail-value"><span class="badge badge-@Model.Status.ToString().ToLower()">@Model.Status</span></span>
    </div>
</div>

<div class="action-row">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-edit-lg">Edit</a>
    <a asp-action="Index" class="btn-back-lg">Back</a>
</div>